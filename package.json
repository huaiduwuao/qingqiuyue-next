{
  "name": "qingqiuyue-next",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "workspaces": []
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=4096 NEXT_TELEMETRY_DISABLED=1 next dev",
    "dev:legacy": "cross-env NODE_OPTIONS=--max-old-space-size=4096 NEXT_TELEMETRY_DISABLED=1 next dev --no-turbopack",
    "build": "next build",
    "build:static": "cross-env NEXT_EXPORT_STATIC=true next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:digital-human": "vitest run src/digital-human/__tests__/commands.parametric.test.ts",
    "tauri": "tauri",
    "app:frontend": "node scripts/app-frontend-build.mjs",
    "app:info": "tauri info",
    "app:dev": "tauri dev",
    "app:windows": "tauri build --target x86_64-pc-windows-msvc --bundles nsis,msi",
    "app:macos": "tauri build --target universal-apple-darwin --bundles app,dmg",
    "app:android": "tauri android build --apk --aab --target aarch64",
    "app:android:tv": "tauri android build --apk --target aarch64 armv7",
    "app:android:dev": "tauri android dev",
    "app:ios:init": "tauri ios init",
    "app:ios": "tauri ios build",
    "app:ios:dev": "tauri ios dev",
    "prepare": "husky"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.0.0",
    "@mui/material": "^9.0.0",
    "@mui/x-data-grid": "^9.3.0",
    "@mui/x-tree-view": "^9.6.0",
    "@pixiv/three-vrm": "^3.5.4",
    "@sentry/nextjs": "^10.75.1",
    "@sparkjsdev/spark": "^2.1.0",
    "@tanstack/react-query": "^5.99.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.12.0",
    "@xyflow/react": "^12.11.2",
    "axios": "^1.15.0",
    "hls.js": "^1.6.16",
    "html-to-image": "^1.11.13",
    "motion": "13.3.0",
    "next": "15.5.26",
    "ogl": "1.0.11",
    "onnxruntime-web": "1.18.0",
    "pinyin-pro": "^3.28.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.180.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@swc/helpers": "^0.5.15",
    "@tauri-apps/api": "^2",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^6.0.3",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.9",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.1.0",
    "playwright": "^1.61.1",
    "typescript": "^5",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "onnxruntime-web": "1.18.0"
  }
}
