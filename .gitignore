# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 本地 next dev 日志(后台启动 npm run dev 时生成)
.dev.log
.dev.log.err
dev-restart.log

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# scratch / debug
/tmp/
/verify_*.py

# 数字人演示视频(大文件,clone 后自备,见 public/avatar/clips.example.json)
/public/avatar/clips/*.mp4

# Edge-TTS 生成的音频缓存(运行时产生,可随时清)
/public/avatars/audio-cache/*.mp3

# COLMAP / 3DGS 重建管线的 staging 目录(脚本运行时生成)
/public/avatars/pipeline/

# 数字人 Web UI 管线的本地 workdir(input.mp4 / 中间产物 / deploy)
/.avatar-work/

# 本地 agent/编辑器配置
/.claude/launch.json

# compose 增量构建标记
.last-build-web

# 注:public/avatars/{model.glb,outfits/*.glb,scenes/*.glb,demo.html,person-test.mp4}
# 是项目自带的数字人资产,NOT 排除,要让 docker build COPY 进镜像。
# 但 public/avatars/pipeline/ 和 audio-cache/ 是运行时产物,已在上方 exclude。

# ─── 防止下次再 untracked 一堆核心文件 ───
# 模型/数据/训练产物(很大,不该进 git)
/data/
/models/
*.pt
*.pth
*.onnx.data
*.pkl

# 测试/调试产物(临时)
/test.mp3
/test.wav
/test_out.wav
*.test.wav

# 工具脚本输出
/lint-output.txt
/unused-vars.txt
/DIGITAL-HUMAN-INTEGRATION.md
/analyze-unused.py
/remove-unused-imports.py
/scripts/__pycache__/
**/__pycache__/

# node_modules 里的 token 文件等(防御)
/node_modules/.cache/
/node_modules/.package-lock.json

# Playwright E2E 登录态(运行时生成,含 token,不入库)
/e2e/.auth/
/test-results/
/playwright-report/

# 临时草稿/消息文件
/_msg*.txt

