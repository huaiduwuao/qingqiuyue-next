{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "清秋月",
  "version": "1.0.0",
  "identifier": "app.qingqiuyue.desktop",
  "build": {
    "devUrl": "http://localhost:3000",
    "frontendDist": "../out",
    "beforeBuildCommand": "NEXT_PUBLIC_API_BASE_URL=https://qingqiuyue.com pnpm build:static"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "清秋月",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
