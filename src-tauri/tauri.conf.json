{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "清秋月",
  "version": "1.0.0",
  "identifier": "app.qingqiuyue.desktop",
  "build": {
    "devUrl": "http://localhost:3000",
    "frontendDist": "../.next/standalone",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "清秋月",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "url": "http://localhost:3000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://* wss://* http://localhost:* https://localhost:* ws://localhost:*; img-src 'self' data: https://*; frame-src https://*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "qingqiuyue.com",
    "category": "Entertainment",
    "shortDescription": "清秋月 - 数字人互动平台",
    "longDescription": "青伙月是一款创新的数字人互动平台，提供丰富的数字人资源、智能对话、创作工具等功能。",
    "copyright": "Copyright © 2024 qingqiuyue.com",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "macOS": {
      "minimum-system-version": "10.15"
    },
    "ios": {
      "minimum-system-version": "13.0"
    },
    "android": {
      "minSdkVersion": 24
    }
  },
  "plugins": {}
}
